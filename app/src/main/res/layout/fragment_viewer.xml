<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050608">

    <!-- Scanlines overlay -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_scanlines"
        android:alpha="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Bar - Glass -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass_topbar"
        android:elevation="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/app_logo"
            android:background="@drawable/bg_logo_glow"
            android:padding="6dp"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#F0F2F5"
                android:textSize="12sp"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.05"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF8A1E"
                android:textSize="9sp"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.08"
                android:visibility="gone" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnWhatsapp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_button_circle"
            android:src="@drawable/ic_whatsapp"
            android:contentDescription="واتساب"
            android:padding="7dp" />

        <TextView
            android:id="@+id/btnToggleDxf"
            android:layout_width="44dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_glass_button_2050"
            android:gravity="center"
            android:text="2D"
            android:textColor="#FF8A1E"
            android:textSize="11sp"
            android:fontFamily="@font/orbitron"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/toggle_dxf_view"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Viewer Container -->
    <FrameLayout
        android:id="@+id/viewerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/displayToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.amr3d.preview.pro.GLViewerView
            android:id="@+id/glViewerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.amr3d.preview.pro.ParticleFieldView
            android:id="@+id/particleField"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <com.amr3d.preview.pro.PivotFeedbackView
            android:id="@+id/pivotFeedbackView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <com.amr3d.preview.pro.DXF2DView
            android:id="@+id/dxf2DView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Data Overlay - Top Right like HTML -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modelStatsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#80FF8A1E"
                android:textSize="9sp"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.08"
                android:gravity="end"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Corner Accents -->
        <View android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="top|start" android:layout_margin="10dp" android:background="@drawable/bg_corner_tl" />
        <View android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="top|end" android:layout_margin="10dp" android:background="@drawable/bg_corner_tr" />
        <View android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="bottom|start" android:layout_margin="10dp" android:background="@drawable/bg_corner_bl" />
        <View android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="bottom|end" android:layout_margin="10dp" android:background="@drawable/bg_corner_br" />

        <!-- Dxf Gap Card - Glass -->
        <LinearLayout
            android:id="@+id/dxfGapCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card_2050"
            android:elevation="8dp"
            android:padding="6dp"
            android:visibility="gone">
            <CheckBox
                android:id="@+id/cbHighlightDxfGaps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:buttonTint="#FF8A1E"
                android:text="@string/dxf_highlight_gaps"
                android:textColor="#F0F2F5"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_file_loaded"
            android:textColor="#4DF0F2F5"
            android:textSize="12sp"
            android:fontFamily="@font/orbitron"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp">

            <Button
                android:id="@+id/btnDirections"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="◫"
                android:textSize="14sp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="#1A0A0C10"
                android:textColor="#FF8A1E"
                android:elevation="6dp" />

            <FrameLayout
                android:id="@+id/directionsPanel"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_marginTop="50dp"
                android:layoutDirection="ltr"
                android:background="@drawable/bg_glass_card_2050"
                android:elevation="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/compassRing"
                    android:layout_width="94dp"
                    android:layout_height="94dp"
                    android:layout_gravity="center"
                    android:src="@drawable/bg_compass_ring" />

                <Button android:id="@+id/btnViewTop" style="@style/Widget.MaterialComponents.Button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="50dp" android:layout_marginTop="6dp" android:text="@string/dir_up" android:textSize="8sp" android:textColor="#F0F2F5" android:background="@drawable/bg_glass_button_circle" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/btnViewLeft" style="@style/Widget.MaterialComponents.Button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="6dp" android:layout_marginTop="50dp" android:text="@string/dir_left" android:textSize="8sp" android:textColor="#F0F2F5" android:background="@drawable/bg_glass_button_circle" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/btnViewRight" style="@style/Widget.MaterialComponents.Button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="94dp" android:layout_marginTop="50dp" android:text="@string/dir_right" android:textSize="8sp" android:textColor="#F0F2F5" android:background="@drawable/bg_glass_button_circle" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/btnViewBottom" style="@style/Widget.MaterialComponents.Button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="50dp" android:layout_marginTop="94dp" android:text="@string/dir_down" android:textSize="8sp" android:textColor="#F0F2F5" android:background="@drawable/bg_glass_button_circle" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/btnViewBack" style="@style/Widget.MaterialComponents.Button" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="96dp" android:layout_marginTop="96dp" android:text="@string/dir_back" android:textSize="7sp" android:textColor="#F0F2F5" android:alpha="0.8" android:background="@drawable/bg_glass_button_circle" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/btnViewFront" style="@style/Widget.MaterialComponents.Button" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="47dp" android:layout_marginTop="47dp" android:text="@string/dir_front" android:textSize="9sp" android:textAllCaps="false" android:textColor="#1A0E02" android:textStyle="bold" android:background="@drawable/bg_compass_center" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:elevation="2dp" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/loadingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_loading"
            android:padding="16dp"
            android:visibility="gone">
            <TextView android:id="@+id/loadingText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF8A1E" android:textSize="10sp" android:fontFamily="@font/orbitron" android:letterSpacing="0.1" android:gravity="center" android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp" />
            <ProgressBar android:id="@+id/loadingProgress" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:progress="0" android:progressTint="#FF8A1E" android:progressBackgroundTint="#1AFFFFFF" />
        </LinearLayout>

        <TextView android:id="@+id/welcomeOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:textColor="#FFFFFFFF" android:textSize="26sp" android:fontFamily="@font/orbitron" android:textStyle="bold" android:background="#E6050608" android:visibility="gone" />

        <androidx.cardview.widget.CardView android:id="@+id/measurementCard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="12dp" app:cardBackgroundColor="#CC0A0C10" app:cardCornerRadius="14dp" app:cardElevation="8dp" app:strokeColor="#33FF8A1E" app:strokeWidth="1dp" android:visibility="gone">
            <TextView android:id="@+id/measurementText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="14dp" android:textColor="#FF8A1E" android:textSize="11sp" android:fontFamily="@font/orbitron" android:letterSpacing="0.05" />
        </androidx.cardview.widget.CardView>

        <Button android:id="@+id/btnToggleToolbars" style="@style/Widget.MaterialComponents.Button" android:layout_width="44dp" android:layout_height="20dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="4dp" android:text="⌄" android:textSize="14sp" android:textColor="#FF8A1E" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#330A0C10" android:elevation="4dp" android:contentDescription="طي أو إظهار شرائط الأدوات" />

        <LinearLayout android:id="@+id/inspectionCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_margin="12dp" android:background="@drawable/bg_glass_card_2050" android:elevation="8dp" android:visibility="gone">
            <TextView android:id="@+id/inspectionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:textColor="#F0F2F5" android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="4dp" />
            <CheckBox android:id="@+id/cbHighlightOpenEdges" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="10dp" android:buttonTint="#FF8A1E" android:text="@string/inspection_highlight_open_edges" android:textColor="#F0F2F5" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>

        <com.amr3d.preview.pro.LightDialOverlayView android:id="@+id/lightDialOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />

        <ImageButton android:id="@+id/btnCloseLightWheel" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="top|end" android:layout_margin="12dp" android:background="@drawable/bg_glass_button_circle" android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="#FF8A1E" android:visibility="gone" android:contentDescription="إغلاق" />

    </FrameLayout>

    <!-- Display Toolbar - Glass 2050 -->
    <LinearLayout
        android:id="@+id/displayToolbar"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_glass_toolbar_2050"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:elevation="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton android:id="@+id/btnWireframe" android:saveEnabled="false" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:padding="8dp" android:scaleType="centerInside" android:background="@drawable/bg_glass_button_2050" android:src="@drawable/ic_wireframe_glyph" android:tint="#FF8A1E" android:contentDescription="@string/wireframe" />
        <ImageButton android:id="@+id/btnMaterial" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:padding="8dp" android:scaleType="centerInside" android:background="@drawable/bg_glass_button_2050" android:src="@drawable/ic_material_palette" android:tint="#FF8A1E" android:contentDescription="@string/material" />
        <Button android:id="@+id/btnUnit" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="@string/unit_mm" android:textAllCaps="false" android:textSize="10sp" android:fontFamily="@font/orbitron" android:textColor="#F0F2F5" android:backgroundTint="#1AFF8A1E" app:strokeColor="#33FF8A1E" app:cornerRadius="12dp" />
        <ImageButton android:id="@+id/btnExport" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:padding="8dp" android:scaleType="centerInside" android:background="@drawable/bg_glass_button_2050" android:src="@drawable/ic_camera_export" android:tint="#FF8A1E" android:contentDescription="@string/export_image" />
        <ImageButton android:id="@+id/btnLightToggle" android:saveEnabled="false" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:padding="8dp" android:scaleType="centerInside" android:background="@drawable/bg_glass_button_2050" android:src="@drawable/ic_light_bulb" android:tint="#FF8A1E" android:contentDescription="@string/light" />
    </LinearLayout>

    <!-- Bottom Toolbar - Glass 2050 -->
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_glass_toolbar_2050"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton android:id="@+id/btnAutoRotate" android:saveEnabled="false" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:padding="8dp" android:scaleType="centerInside" android:background="@drawable/bg_glass_button_2050" android:src="@drawable/ic_rotate" android:tint="#FF8A1E" android:contentDescription="تدوير تلقائي" />
        <ImageButton android:id="@+id/btnMeasureTool" android:saveEnabled="false" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:padding="8dp" android:scaleType="centerInside" android:background="@drawable/bg_glass_button_2050" android:src="@drawable/ic_measure_ruler" android:tint="#FF8A1E" android:contentDescription="@string/measure_tool" />
        <ImageButton android:id="@+id/btnInspect" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:padding="8dp" android:scaleType="centerInside" android:background="@drawable/bg_glass_button_2050" android:src="@drawable/ic_inspect" android:tint="#FF8A1E" android:contentDescription="@string/inspect_tool" />
        <ImageButton android:id="@+id/btnResetView" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:padding="8dp" android:scaleType="centerInside" android:background="@drawable/bg_glass_button_2050" android:src="@drawable/ic_reset_view" android:tint="#FF8A1E" android:contentDescription="@string/reset_view" />
        <ImageButton android:id="@+id/btnBoundingBox" android:saveEnabled="false" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:padding="8dp" android:scaleType="centerInside" android:background="@drawable/bg_glass_button_2050" android:src="@drawable/ic_bounding_box" android:tint="#FF8A1E" android:contentDescription="صندوق الأبعاد" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
