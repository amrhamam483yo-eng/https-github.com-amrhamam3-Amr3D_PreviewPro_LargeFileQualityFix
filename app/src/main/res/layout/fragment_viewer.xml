<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050608">

    <!-- Viewer Fullscreen -->
    <FrameLayout
        android:id="@+id/viewerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.amr3d.preview.pro.GLViewerView
            android:id="@+id/glViewerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="#33FF8A1E" />

        <!-- Ambient Glow -->
        <View
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="80dp"
            android:background="@drawable/bg_ambient_glow" />

        <com.amr3d.preview.pro.ParticleFieldView
            android:id="@+id/particleField"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <com.amr3d.preview.pro.PivotFeedbackView
            android:id="@+id/pivotFeedbackView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <com.amr3d.preview.pro.DXF2DView
            android:id="@+id/dxf2DView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Top Info Bar like HTML status bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:32"
                android:textColor="#FF8A1E"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.15" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMR3D • 2050"
                android:textColor="#40F0F2F5"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2" />
        </LinearLayout>

        <!-- Corner Accents -->
        <View android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="top|start" android:layout_marginTop="60dp" android:layout_marginStart="16dp" android:background="@drawable/bg_corner_tl" />
        <View android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="top|end" android:layout_marginTop="60dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_corner_tr" />

        <!-- Data Overlay -->
        <TextView
            android:id="@+id/modelStatsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="70dp"
            android:layout_marginEnd="20dp"
            android:textColor="#80FF8A1E"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:visibility="gone" />

        <!-- TopBar Logo - Floating -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="100dp"
            android:layout_marginStart="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_glass_card_2050"
            android:padding="8dp">

            <ImageView
                android:id="@+id/appLogo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/app_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/app_name"
                android:textColor="#F0F2F5"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <!-- DXF Gap Card -->
        <LinearLayout
            android:id="@+id/dxfGapCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="160dp"
            android:background="@drawable/bg_glass_card_2050"
            android:visibility="gone">
            <CheckBox
                android:id="@+id/cbHighlightDxfGaps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:buttonTint="#FF8A1E"
                android:text="@string/dxf_highlight_gaps"
                android:textColor="#F0F2F5"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_file_loaded"
            android:textColor="#40F0F2F5"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center" />

        <!-- Directions Button & Panel -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="160dp"
            android:layout_marginStart="10dp">

            <Button
                android:id="@+id/btnDirections"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="◫"
                android:textSize="12sp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="#1A0A0C10"
                android:textColor="#FF8A1E" />

            <FrameLayout
                android:id="@+id/directionsPanel"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_marginTop="50dp"
                android:background="@drawable/bg_glass_card_2050"
                android:visibility="gone">
                <Button android:id="@+id/btnViewTop" style="@style/Widget.MaterialComponents.Button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="50dp" android:layout_marginTop="6dp" android:text="@string/dir_up" android:textSize="8sp" android:background="@drawable/bg_glass_button_circle" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/btnViewLeft" style="@style/Widget.MaterialComponents.Button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="6dp" android:layout_marginTop="50dp" android:text="@string/dir_left" android:textSize="8sp" android:background="@drawable/bg_glass_button_circle" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/btnViewRight" style="@style/Widget.MaterialComponents.Button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="94dp" android:layout_marginTop="50dp" android:text="@string/dir_right" android:textSize="8sp" android:background="@drawable/bg_glass_button_circle" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/btnViewBottom" style="@style/Widget.MaterialComponents.Button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="50dp" android:layout_marginTop="94dp" android:text="@string/dir_down" android:textSize="8sp" android:background="@drawable/bg_glass_button_circle" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/btnViewBack" style="@style/Widget.MaterialComponents.Button" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="96dp" android:layout_marginTop="96dp" android:text="@string/dir_back" android:textSize="7sp" android:background="@drawable/bg_glass_button_circle" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/btnViewFront" style="@style/Widget.MaterialComponents.Button" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="47dp" android:layout_marginTop="47dp" android:text="@string/dir_front" android:textSize="9sp" android:background="@drawable/bg_compass_center" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <ImageView android:id="@+id/compassRing" android:layout_width="94dp" android:layout_height="94dp" android:layout_gravity="center" android:src="@drawable/bg_compass_ring" android:visibility="gone"/>
            </FrameLayout>
        </FrameLayout>

        <!-- Loading -->
        <LinearLayout
            android:id="@+id/loadingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#F2050608"
            android:padding="16dp"
            android:visibility="gone"
            android:orientation="vertical">
            <TextView android:id="@+id/loadingText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF8A1E" android:textSize="10sp" android:fontFamily="monospace" android:layout_gravity="center_horizontal" />
            <ProgressBar android:id="@+id/loadingProgress" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" android:progressTint="#FF8A1E" />
        </LinearLayout>

        <TextView android:id="@+id/welcomeOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="#FFF" android:textSize="22sp" android:background="#E6050608" android:visibility="gone" />

        <androidx.cardview.widget.CardView android:id="@+id/measurementCard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="16dp" app:cardBackgroundColor="#CC0A0C10" app:cardCornerRadius="14dp" app:strokeColor="#33FF8A1E" app:strokeWidth="1dp" android:visibility="gone">
            <TextView android:id="@+id/measurementText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="14dp" android:textColor="#FF8A1E" android:textSize="11sp" android:fontFamily="monospace" />
        </androidx.cardview.widget.CardView>

        <LinearLayout android:id="@+id/inspectionCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_margin="16dp" android:background="@drawable/bg_glass_card_2050" android:visibility="gone">
            <TextView android:id="@+id/inspectionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:textColor="#F0F2F5" android:textSize="11sp" android:fontFamily="monospace" />
            <CheckBox android:id="@+id/cbHighlightOpenEdges" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="10dp" android:buttonTint="#FF8A1E" android:text="@string/inspection_highlight_open_edges" android:textColor="#F0F2F5" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>

        <com.amr3d.preview.pro.LightDialOverlayView android:id="@+id/lightDialOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
        <ImageButton android:id="@+id/btnCloseLightWheel" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="top|end" android:layout_margin="16dp" android:background="@drawable/bg_glass_button_circle" android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="#FF8A1E" android:visibility="gone" />

        <!-- Toggle Toolbars FAB like HTML -->
        <Button
            android:id="@+id/btnToggleToolbars"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="110dp"
            android:layout_marginEnd="16dp"
            android:text="◐"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#1A0A0C10"
            android:textColor="#FF8A1E"
            android:elevation="6dp" />
    </FrameLayout>

    <!-- ═══ TRUE 2050 GLASS TOOLBARS - FLOATING CAPSULES ═══ -->

    <!-- Top Toolbar - Floating Center -->
    <LinearLayout
        android:id="@+id/displayToolbar"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_glass_toolbar_2050"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        android:elevation="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageButton android:id="@+id/btnWireframe" android:saveEnabled="false" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="@drawable/bg_glass_button_circle" android:src="@drawable/ic_wireframe_glyph" android:tint="#FF8A1E" android:padding="9dp" />
        <ImageButton android:id="@+id/btnMaterial" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="@drawable/bg_glass_button_circle" android:src="@drawable/ic_material_palette" android:tint="#FF8A1E" android:padding="9dp" />
        <Button android:id="@+id/btnUnit" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="48dp" android:layout_height="40dp" android:layout_margin="4dp" android:text="MM" android:textSize="10sp" android:textColor="#F0F2F5" app:cornerRadius="20dp" app:strokeColor="#33FF8A1E" />
        <ImageButton android:id="@+id/btnExport" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="@drawable/bg_glass_button_circle" android:src="@drawable/ic_camera_export" android:tint="#FF8A1E" android:padding="9dp" />
        <ImageButton android:id="@+id/btnLightToggle" android:saveEnabled="false" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="@drawable/bg_glass_button_circle" android:src="@drawable/ic_light_bulb" android:tint="#FF8A1E" android:padding="9dp" />
    </LinearLayout>

    <!-- Bottom Toolbar - Floating Center -->
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_glass_toolbar_2050"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        android:elevation="16dp"
        app:layout_constraintTop_toBottomOf="@id/displayToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton android:id="@+id/btnAutoRotate" android:saveEnabled="false" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="@drawable/bg_glass_button_circle" android:src="@drawable/ic_rotate" android:tint="#FF8A1E" android:padding="9dp" />
        <ImageButton android:id="@+id/btnMeasureTool" android:saveEnabled="false" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="@drawable/bg_glass_button_circle" android:src="@drawable/ic_measure_ruler" android:tint="#FF8A1E" android:padding="9dp" />
        <ImageButton android:id="@+id/btnInspect" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="@drawable/bg_glass_button_circle" android:src="@drawable/ic_inspect" android:tint="#FF8A1E" android:padding="9dp" />
        <ImageButton android:id="@+id/btnResetView" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="@drawable/bg_glass_button_circle" android:src="@drawable/ic_reset_view" android:tint="#FF8A1E" android:padding="9dp" />
        <ImageButton android:id="@+id/btnBoundingBox" android:saveEnabled="false" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="@drawable/bg_glass_button_circle" android:src="@drawable/ic_bounding_box" android:tint="#FF8A1E" android:padding="9dp" />
    </LinearLayout>

    <!-- Floating 2D Toggle FAB like HTML -->
    <TextView
        android:id="@+id/btnToggleDxf"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_fab_ring"
        android:gravity="center"
        android:text="2D"
        android:textColor="#FF8A1E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/bottomToolbar"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp" />

    <!-- Whatsapp FAB -->
    <ImageButton
        android:id="@+id/btnWhatsapp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_glass_button_circle"
        android:src="@drawable/ic_whatsapp"
        android:padding="12dp"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/displayToolbar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
